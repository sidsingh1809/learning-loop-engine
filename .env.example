# Run python3 scripts/init_local_env.py to generate .env with random local credentials.
MYSQL_DATABASE=learning_loop
MYSQL_USER=loop_app
MYSQL_PASSWORD=replace-with-random-local-password
MYSQL_ROOT_PASSWORD=replace-with-different-random-password
API_KEY=replace-with-random-key-at-least-32-characters
DATABASE_URL=mysql+pymysql://loop_app:replace-with-random-local-password@127.0.0.1:3307/learning_loop?charset=utf8mb4
# API_KEY maps to dev-author. Setup adds instructor, two synthetic learner and integration keys.
# JSON array of server-configured {subject, roles, api_key}; never put real identities here.
DEV_PRINCIPALS=[]
